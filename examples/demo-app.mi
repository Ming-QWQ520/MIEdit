files_map = []

[app]
name = "MIEdit Demo"
version = "1.3.0"
publisher = "MIEdit Project"
app_id = ""
exe = "MIEditDemo.exe"
# 图标说明：未配置时自动使用内置默认 modern-install.ico / modern-uninstall.ico
url = ""
per_machine = false

[install]
uninstall_background = "assets/images/bg.png"
dir_template = '{localappdata}\Programs\MIEdit Demo'
run_after = "MIEditDemo.exe"
user_data_dirs = ['{appdata}\MIEdit Demo']
compression = "deflate"                      # deflate|solid|lzma|lzma-solid|brotli|brotli-solid（NSIS SetCompressor 对齐 + 扩展）
# UAC 执行级别（NSIS RequestExecutionLevel，路线图步骤 36）：
# user（asInvoker）| highest（highestAvailable）| admin（requireAdministrator）；
# 未声明时按 per_machine 推导：全机 → admin，按用户 → user。
# 编译器把级别写入安装器/卸载器 EXE 的 application manifest（RT_MANIFEST），
# 同时声明 supportedOS（Vista…Win11）与 DPI/长路径感知。
# request_execution_level = "admin"
# 允许安装到盘根/网络共享根（NSIS AllowRootDirInstall，默认 false 禁止）
# allow_root_dir_install = true

# 自定义命令（NSIS Exec/ExecWait，路线图步骤 23）：
# 安装前/后、卸载前均可执行；{install_dir} 模板可用；
# abort_on_error = true 时退出码非 0 中止安装；optional = true 时程序缺失仅告警
# [[install.exec_before]]
# cmd = 'cmd'
# args = '/c ver'
#
# [[install.exec_after]]
# cmd = '{install_dir}\MIEditDemo.exe'
# args = '--post-install'
# abort_on_error = false
#
# [[install.exec_before_uninstall]]
# cmd = 'taskkill'
# args = '/IM MIEditDemo.exe /F'
# optional = true

# 环境变量（NSIS WriteEnvStr 惯例 / Inno ChangesEnvironment，路线图步骤 27）：
# part = "all" 直接设值（卸载时还原安装前原值）/ "path_append" 追加 /
# "path_prepend" 前置（PATH 式 `;` 列表去重合并，卸载时只移除本安装写入的段）；
# scope = "user"（HKCU，默认）| "machine"（HKLM，需管理员）。
# 写入后广播 WM_SETTINGCHANGE，新启动进程立即可见，无需注销。
# [[install.env]]
# name = "MIEDIT_HOME"
# value = "{install_dir}"
# part = "all"
# scope = "user"
#
# [[install.env]]
# name = "Path"
# value = "{install_dir}"
# part = "path_append"
# scope = "user"

# 内置界面模板（五选一：aurora / midnight / sunrise / forest / mono）
# template = "midnight"
# 液态玻璃材质（默认 glass；standard = 旧观感）；Win11 亚克力需 acrylic = true
# material = "glass"
# acrylic = true
# 左列步骤导航栏（HM NIS Edit 式，默认开启）
# show_step_rail = true

[[install.run_tasks]]
name = "运行 {app}"
exe = "MIEditDemo.exe"
args = ""
default_checked = true

[[install.run_tasks]]
name = "查看使用指南"
exe = "docs/guide.md"
args = ""
default_checked = false

[ui]
window_size = [
    980.0,
    640.0,
]
background = "assets/images/bg.png"
background_style = "cover"
accent = "#4F8CFF"
license = "assets/LICENSE.txt"
license_scroll_required = true
show_components_page = true
show_dir_page = true

# 多语言框架（NSIS MUI2 `MUI_LANGUAGE` 对齐，路线图步骤 15）：
# 定义 >1 个语言时，欢迎页前显示语言选择页；启动时按系统 UI 语言自动预选
# （language_auto_detect = true 默认开启）。未覆盖的文案键由内置语言包补全
# （内置 zh-CN 为完整中文、en-US 为英文默认）；[ui.text] 仍是最高优先级单键覆盖。
[[ui.languages]]
id = "zh-CN"
name = "简体中文"

[ui.languages.text]
app_running_body = "{app} 似乎正在运行。请先关闭它后点击「重试检测」，或点击「仍然继续」忽略。"
app_running_title = "检测到程序正在运行"
back = "上一步"
browse = "浏览..."
cancel = "取消"
components_desc = "请选择要安装的 {app} 组件："
components_desc_empty = "将鼠标悬停在组件上查看说明。"
components_desc_panel = "组件说明"
components_required = "必装"
components_reset = "重置"
components_select_all = "全选"
components_title = "选择组件"
components_type_custom = "自定义"
components_type_title = "安装类型："
continue_anyway = "仍然继续"
dir_desc = """
{app} 将安装到以下文件夹。
点击「立即安装」开始，或点击「浏览...」更换位置。"""
dir_title = "选择安装位置"
disk_space = "预计需要空间：{size}"
done_btn = "完成"
error_title = "安装失败"
exit_body = "安装尚未完成，确定要退出吗？"
extracting = "正在解压：{file}"
finalizing = "正在写入卸载程序与快捷方式..."
finish_body = "{app} {version} 已成功安装到："
finish_title = "安装完成"
free_space = "磁盘可用空间：{free}"
install_now = "立即安装"
installing = "正在安装 {app}"
license_accept = "我接受上述协议条款"
license_desc = "请仔细阅读以下许可协议。"
license_title = "许可协议"
next = "下一步"
preparing = "准备安装..."
retry = "重试检测"
run_app = "运行 {app}"
welcome_body = """
本向导将把 {app} {version} 安装到你的电脑。

建议在继续之前关闭其他正在运行的程序。"""
welcome_chip = "欢 迎"
window_title = "{app} 安装向导"

[[ui.languages]]
id = "en-US"
name = "English"

[shortcuts]
start_menu = true
desktop = true
run_args = ""

# 快捷方式条目（Inno [Icons] 风格，路线图步骤 13）：与上方简单开关叠加生效
[[shortcuts.entries]]
name = "使用指南"
exe = "docs/guide.md"         # 包内相对路径，空 = 主程序
comment = "查看 MIEdit Demo 使用指南"
locations = ["desktop"]       # start_menu / desktop / quick_launch

[[shortcuts.entries]]
name = "数据工具"
exe = ""
subfolder = "工具"            # 开始菜单子目录（空 = 应用名分组目录）
locations = ["start_menu"]

[[files]]
source = "demo-payload/*"
dest = ""

[[files]]
source = "demo-payload/docs/**"
dest = "docs"

[[files]]
source = "demo-payload/data"
dest = "data"

[[registry]]
key = 'HKCU\Software\MIEdit-Demo'

[registry.values]
InstallPath = "{install_dir}"
Version = "1.3.0"

# 注册表全类型与视图（NSIS WriteRegDWORD/WriteRegBin/WriteRegExpandStr/
# WriteRegMultiSz/SetRegView，路线图步骤 22）：
# dwords = { Flags = "1", Debug = "0x80" }        # 十进制或 0x 十六进制
# binary = { Blob = "DE AD BE EF" }                # 十六进制，长度偶数，可含空白
# expand_sz = { EnvPath = "%PATH%;{install_dir}" } # REG_EXPAND_SZ
# multi_sz = { List = ["a", "b"] }                 # REG_MULTI_SZ
# view = "64"                                      # default / 64 / 32（SetRegView）

[[components]]
name = "核心程序"
description = "主程序与运行数据（必需）"
required = true
files = [
    0,
    2,
]

[[components]]
name = "文档"
description = "使用指南与说明文档"
required = false
files = [1]

# MI 脚本 v2 组件指令（NSIS Section 指令语义，路线图步骤 33）：
# 组件被勾选后按脚本顺序执行其 code 指令，未勾选组件不执行；
# 失败记警告继续（NSIS error-flag 语义），run 的 abort_on_error = true 显式中止。
# op = "run"          → NSIS Exec/ExecWait
# op = "write_reg"    → NSIS WriteRegStr / WriteRegDWORD（type = "str"|"dword"）
# op = "create_dir"   → NSIS CreateDirectory
# op = "delete_file"  → NSIS Delete（缺失静默跳过）
# op = "rename"       → NSIS Rename（同盘重命名/移动，目标已存在则失败）
# op = "copy_files"   → NSIS CopyFiles（文件或整目录树，同名覆盖）
# op = "write_ini"    → NSIS WriteINIStr（节/键不区分大小写，文件缺失则新建）
# op = "sleep"        → NSIS Sleep（暂停 ms 毫秒）
# op = "detail_print" → NSIS DetailPrint
# 路径支持 NSIS 常量变量：$INSTDIR $DESKTOP $SMPROGRAMS $STARTMENU
# $QUICKLAUNCH $APPDATA $LOCALAPPDATA $TEMP $WINDIR $SYSDIR $PROGRAMFILES $EXEDIR
# 注意：[[components]] 是数组表，code 必须以内联表数组形式写在组件表内
# （[[components."名称".code]] 会变成独立的未知子表，不会挂到组件上）。
#
# [[components]]
# name = "文档"
# files = [1]
# code = [
#   { op = "detail_print", text = "正在注册文档关联…" },
#   { op = "write_reg", key = "HKCU\\Software\\MIEdit Demo", name = "DocsPath", value = "$INSTDIR\\docs" },
#   { op = "create_dir", path = "$APPDATA\\MIEdit Demo\\docs" },
#   { op = "write_ini", file = "$INSTDIR\\config.ini", section = "Main", key = "Mode", value = "fast" },
#   { op = "copy_files", from = "$INSTDIR\\docs", to = "$APPDATA\\MIEdit Demo\\docs" },
#   { op = "rename", from = "$INSTDIR\\old.log", to = "$INSTDIR\\old.log.bak" },
#   { op = "sleep", ms = 250 },
#   { op = "run", cmd = "$INSTDIR\\docs\\register.bat", args = "/quiet", abort_on_error = false },
# ]

# 组件分组（NSIS SectionGroup/SectionGroupEnd，路线图步骤 24）：
# group = "父组/子组"（/ 分隔多级），空 = 根级；中间组自动创建、
# 组件页树形渲染（组行可折叠/展开，组复选框三态联动子组件）
# group = "工具/压缩"

[[install_types]]
# NSIS InstallTypes：组件页顶部单选；选中后按 components 重置勾选
name = "典型"
components = [0]
default = true

[[install_types]]
name = "完整"
components = [0, 1]
